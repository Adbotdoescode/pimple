  "segments": [
    { "id": "s1", "text": "This is a mass on an ideal spring, pulled away from rest and then let go." },
    { "id": "s2", "text": "The spring pushes it back toward equilibrium with a restoring force, F equals minus k x, that grows with how far it is pulled." },
    { "id": "s3", "text": "The angular frequency, omega, equals the square root of k over m, so a stiffer spring or a lighter mass swings faster." }
  ],
