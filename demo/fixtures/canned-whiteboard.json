{
  "concept": "Normal force on an incline",
  "surface": "whiteboard",
  "grounding": {
    "source_type": "fixed_source",
    "source_ref": "demo: canned free-body diagram for a block on a 30° incline",
    "quote": "N = mg cos θ"
  },
  "segments": [
    {
      "id": "s1",
      "text": "Here is a block resting on a rough incline tilted at thirty degrees."
    },
    {
      "id": "s2",
      "text": "Gravity pulls it straight down with mg, which is 49 newtons, and that splits into a part along the slope and a part into it."
    },
    {
      "id": "s3",
      "text": "The surface pushes back with the normal force N, 42 newtons, perpendicular to the slope, while friction f holds the block up the slope."
    },
    {
      "id": "s4",
      "text": "Drag the angle slider and watch N shrink as the slope steepens, because N equals mg cos θ, and the graph traces that curve."
    }
  ],
