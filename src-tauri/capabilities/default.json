{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Glass Tutor: one capability for every window",
  "windows": ["brain", "bubble", "overlay", "card", "whiteboard", "settings", "gizmo"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-cursor-position",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-effects",
    "core:window:allow-is-visible",
    "core:webview:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }, { "url": "https://console.anthropic.com/*" }, { "url": "https://elevenlabs.io/*" }]
    },
    "store:default",
    "process:default",
    "dialog:default",
    "log:default",
    "macos-permissions:default",
    "fs:read-files",
    "fs:allow-resource-read-recursive",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**/*" }, { "path": "$APPCACHE/**/*" }, { "path": "/tmp/**/*" }]
    }
  ]
}
